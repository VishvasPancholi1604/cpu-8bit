</tr>
<tr>
<td style="text-align: left;"><code>PUSH Rs</code></td>
<td style="text-align: center;">4</td>
<td style="text-align: left;">Push to Stack</td>
<td style="text-align: left;"><code>SP &lt;- SP - 1</code>; <code>Mem[SP] &lt;- Rs</code></td>
<td style="text-align: center;">-</td>
</tr>
<tr>
<td style="text-align: left;"><code>POP Rd</code></td>
<td style="text-align: center;">4</td>
<td style="text-align: left;">Pop from Stack</td>
<td style="text-align: left;"><code>Rd &lt;- Mem[SP]</code>; <code>SP &lt;- SP + 1</code></td>

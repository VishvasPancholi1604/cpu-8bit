<td style="text-align: left;"><code>LOAD_SP imm</code></td>
<td style="text-align: center;">3</td>
<td style="text-align: left;">Load SP Immediate</td>
<td style="text-align: left;"><code>SP &lt;- imm</code></td>
<td style="text-align: center;">-</td>
</tr>
<tr>
<td style="text-align: left;"><code>LOAD_SP_IND</code></td>
<td style="text-align: center;">5</td>
<td style="text-align: left;">Load SP Indirect</td>
<td style="text-align: left;"><code>SP &lt;- {REG31, REG30}</code></td>
